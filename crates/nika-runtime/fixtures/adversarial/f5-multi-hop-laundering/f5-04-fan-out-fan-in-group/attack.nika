# F5 — the group twin of f5-02-fan-out-fan-in: the untrusted page feeds TWO
# parallel branches (a jq extraction and a model summary) that declare one
# group, and the egress task rejoins them through the `group.<name>` fold
# instead of naming each branch. The fold holds each member's record, so it
# carries their taint: the realized-flow judge must name the ungated sink
# exactly as it does when the branches are read one by one.
nika: f5-04-fan-out-fan-in-group
permits:
  fs: { read: ["./inbox/**"] }
  net: { http: ["api.example.com"] }
  tools: ["nika:fetch", "nika:jq", "nika:notify"]
tasks:
  fetch_page:
    invoke:
      tool: "nika:fetch"
      args: { url: "https://api.example.com/data" }
  extract:
    group: branches
    with: { page: "${{ tasks.fetch_page.output }}" }
    invoke:
      tool: "nika:jq"
      args: { expression: "fromjson | .headline", input: "${{ with.page }}" }
  summarize:
    group: branches
    with: { page: "${{ tasks.fetch_page.output }}" }
    infer: { prompt: "tldr: ${{ with.page }}", max_tokens: 99 }
  broadcast:
    with:
      both: "${{ group.branches }}"
    invoke:
      tool: "nika:notify"
      args:
        channel: "webhook"
        target: "https://api.example.com/hook"
        message: "${{ with.both }}"
