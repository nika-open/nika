    { "schema": "JournalEvidence", "member": "status", "values": ["mirror_lost"] },
    { "schema": "JournalEvidence", "member": "reason", "values": ["write_failed", "record_refused"] },
    { "schema": "SnapshotValidationAck", "member": "status", "values": ["accepted"] },
    { "schema": "JobOrigin", "variant": "schedule", "member": "decision", "values": ["scheduled", "catch_up"] },
    { "schema": "JobOrigin", "variant": "schedule", "member": "schedule_origin", "values": ["project", "api"] },
    { "schema": "CompileOutcome", "member": "status", "values": ["ready", "incomplete", "refused"] },
