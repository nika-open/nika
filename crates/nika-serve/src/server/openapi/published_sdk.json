{
  "sdk": "@nika-open/nika@0.125.0",
  "read_from": "the published dist/index.js (npm integrity sha512-NSFShkRocsX6Zvx0oUdrponH5MMBVTIq/0MFSXjMGgiayDjK5cs3hex3Jrlaun8TaaAYuJoPVy0T4mUeQpWnFw==, read 24 Nov 2026): the keys and values each closed parser accepts",
