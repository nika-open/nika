    },
    {
      "schema": "AccessOfferRoute",
      "keys": [
        "via", "protocol", "profile", "tasks", "status", "observed_at", "fresh_until", "code", "reason",
        "adapter", "model", "effort", "service_tier"
      ]
    },
    { "schema": "AccessOfferRoute", "member": "adapter", "keys": ["name", "version"] },
    {
      "schema": "AccessOfferRoute",
      "member": "model",
      "keys": ["requested", "status", "current", "offered", "omitted"]
    },
    { "schema": "AccessOfferListing", "keys": ["status", "option", "offered", "omitted", "current", "reason"] }
  ],
  "enums": [
