    },
    { "schema": "JournalEvidence", "keys": ["status", "reason"] },
    { "schema": "SnapshotValidationAck", "keys": ["status", "snapshot_digest", "root", "units"] },
    { "schema": "Error", "keys": ["error"] },
    { "schema": "Error", "member": "error", "keys": ["code", "message"] },
    { "schema": "WorkflowList", "keys": ["workflows"] },
    { "schema": "WorkflowMetadata", "keys": ["workflow"] },
    {
      "schema": "AccessOffer",
      "keys": ["schema", "workflow", "status", "reason", "declared", "prompts_sent", "routes", "routes_omitted"]
    },
    {
      "schema": "AccessOffer",
